<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_document_request" model="ir.ui.view">
        <field name="name">document.request.form.view</field>
        <field name="model">document.request</field>
        <field name="arch" type="xml">
            <form string="Document Request">
                <header>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '0', 'fold_field': 'fold'}"
                           nolabel="1" readonly="1"/>
                    <button name="request_document" string="request" type="object" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="approve_request" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'request'" groups="alh_request_document.group_emp_appr"/>
                    <button name="reject_request_add" string="reject" type="object"
                            invisible="state in ['reject','new','approved']" groups="alh_request_document.group_emp_appr"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <h1>
                        <field name="employee_id" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'new'"/>
                            <field name="doc_type" readonly="state != 'new'"/>
                            <field name="user_id" invisible="1"/>
                            <field name="subject" readonly="state != 'new'"/>
                            <field name="reason" readonly="state != 'new'"/>
                            <field name="reject_reason" readonly="1"/>

                        </group>
                    </group>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <record id="view_tree_document_request" model="ir.ui.view">
        <field name="name">document.request.tree.view</field>
        <field name="model">document.request</field>
        <field name="arch" type="xml">
            <list string="Document Request" create="1" delete="1">
                <field name="user_id" column_invisible="1"/>
                <field name="employee_id" readonly="1"/>
                <field name="name"/>
                <field name="reason"/>
                <field name="subject"/>
                <field name="state" widget='badge' decoration-success="state == 'approved'"
                       decoration-info="state == 'request'" decoration-danger="state == 'reject'"/>
                <button name="request_document" string="request" type="object" class="btn-primary"
                        invisible="state != 'new'"/>
                <button name="approve_request" string="Approve" type="object" class="btn-primary"
                        invisible="state != 'request'" groups="alh_request_document.group_emp_appr"/>
                <button name="reject_request_add" string="reject" type="object"
                        invisible="state in ['reject','new','approved']" groups="alh_request_document.group_emp_appr"
                        class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_search_document_request" model="ir.ui.view">
        <field name="name">document.request.search.view</field>
        <field name="model">document.request</field>
        <field name="arch" type="xml">
            <search string="Document Request">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="state" select="multi"/>

                <filter string="New" name="filter_new" domain="[('state', '=', 'new')]"/>
                <filter string="Requested" name="filter_request" domain="[('state', '=', 'request')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'reject')]"/>
                <group>
                    <filter name="group_requested_by" string="Employee" domain="[]"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="State" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_user_id" string="User" domain="[]"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="view_form_request_document_type" model="ir.ui.view">
        <field name="name">request.document.type.form.view</field>
        <field name="model">request.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_tree_request_document_type" model="ir.ui.view">
        <field name="name">request.document.type.tree.view</field>
        <field name="model">request.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_request_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">request.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_tree_request_document_type"/>
        <field name="help" type="html">
            <p>
                Create Document Request of employee
            </p>
        </field>
    </record>


    <record id="action_request_document_employee" model="ir.actions.act_window">
        <field name="name">Document Request</field>
        <field name="res_model">document.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_tree_document_request"/>
        <field name="search_view_id" ref="view_search_document_request"/>
        <field name="help" type="html">
            <p>
                Create Document Request of employee
            </p>
        </field>
    </record>

    <menuitem id="menu_document_request_root"
              name="Document Request"
              active="True"
              web_icon="alh_request_document,static/description/document_management_app.png"
              sequence="10">
    </menuitem>

    <menuitem
            name="Document Request"
            id="menu_document_employee_request"
            parent="menu_document_request_root"
            sequence="13"
    >
        <menuitem
                name="Document Request"
                id="menu_document_request_employee"
                action="action_request_document_employee"
                sequence="14"
        />
    </menuitem>

    <menuitem id="menu_document_request_config"
              name="Configuration"
              active="True"
              groups="hr.group_hr_manager"
              parent="menu_document_request_root"
              sequence="20">
    </menuitem>

    <menuitem id="menu_document_type"
              name="Document Types"
              action="action_request_document_type"
              parent="menu_document_request_config"
              sequence="21"/>

</odoo>